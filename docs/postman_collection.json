{
  "info": {
    "_postman_id": "ticketverse-api-collection",
    "name": "TicketVerse High-Concurrency Booking Engine API",
    "description": "Complete API Collection for TicketVerse System endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@ticketverse.com\",\n  \"password\": \"secret123\",\n  \"fullName\": \"Jane Ticketverse\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/v1/auth/register", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@ticketverse.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/v1/auth/login", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "Events & Venues",
      "item": [
        {
          "name": "Get All Events",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/api/v1/events", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "events"] }
          }
        },
        {
          "name": "Get Event By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:8080/api/v1/events/1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "events", "1"] }
          }
        }
      ]
    },
    {
      "name": "Seat Holds & Booking Engine",
      "item": [
        {
          "name": "Create Temporary Seat Hold",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": 1,\n  \"seatIds\": [1, 2]\n}"
            },
            "url": { "raw": "http://localhost:8080/api/v1/holds", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "holds"] }
          }
        },
        {
          "name": "Process Idempotent Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "IDEM-PAYMENT-UUID-1001" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": 1,\n  \"paymentMethod\": \"CREDIT_CARD\"\n}"
            },
            "url": { "raw": "http://localhost:8080/api/v1/payments", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "payments"] }
          }
        }
      ]
    },
    {
      "name": "Virtual Waiting Room & Telemetry",
      "item": [
        {
          "name": "Join Waiting Room",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "http://localhost:8080/api/v1/queue/join?eventId=1", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "queue", "join"], "query": [{ "key": "eventId", "value": "1" }] }
          }
        },
        {
          "name": "Get Executive Analytics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "http://localhost:8080/api/v1/analytics/dashboard", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["api", "v1", "analytics", "dashboard"] }
          }
        }
      ]
    }
  ]
}
